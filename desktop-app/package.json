{
  "name": "desktop-app",
  "version": "1.0.0",
  "description": "DayPulse Standalone Desktop App",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "tsc && electron .",
    "dev": "tsc && electron .",
    "pack:exe": "tsc && electron-builder --win"
  },
  "build": {
    "appId": "com.daypulse.tracker",
    "productName": "DayPulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../assets/favicon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DayPulse"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "electron": "^44.5.1",
    "electron-builder": "^26.4.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.3"
  }
}
