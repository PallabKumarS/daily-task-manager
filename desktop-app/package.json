{
	"name": "desktop-app",
	"productName": "DayPulse",
	"version": "2.0.0",
	"description": "DayPulse Standalone Desktop App",
	"author": "Pallab Kumar Sarker",
	"main": "electron/main.js",
	"scripts": {
		"prepare:server": "node scripts/prepare-server.mjs",
		"build": "node scripts/prepare-server.mjs",
		"dev": "electron .",
		"build:desktop": "node scripts/prepare-server.mjs && electron-builder --win",
		"pack:exe": "node scripts/prepare-server.mjs && electron-builder --win"
	},
	"build": {
		"appId": "com.daypulse.tracker",
		"productName": "DayPulse",
		"directories": {
			"output": "release"
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "assets/daypulse.ico"
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"allowToChangeInstallationDirectory": false,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "DayPulse"
		},
		"asar": true,
		"files": [
			"electron/**/*",
			"assets/**/*"
		],
		"extraResources": [
			{
				"from": "server-dist",
				"to": "server-dist"
			}
		]
	},
	"devDependencies": {
		"electron": "44.5.1",
		"electron-builder": "^26.4.0"
	}
}
