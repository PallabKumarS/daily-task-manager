datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  passwordHash     String
  currency         String            @default("USD")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  routines         Routine[]
  routineLogs      RoutineLog[]
  tasks            Task[]
  transactions     Transaction[]
  googleConnection GoogleConnection?
  categoryOptions  CategoryOption[]
}

model GoogleConnection {
  id               String    @id @default(cuid())
  userId           String    @unique
  googleId         String?
  googleEmail      String?
  encryptedAccess  String
  encryptedRefresh String?
  tokenExpiry      DateTime?
  driveFileId      String?
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Routine {
  id                String       @id @default(cuid())
  userId            String
  title             String
  description       String?
  timeSlot          String       @default("morning")
  targetTime        String?
  daysOfWeek        String       @default("0,1,2,3,4,5,6")
  streakCount       Int          @default(0)
  lastCompletedDate String?
  reminderMinutes   Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs              RoutineLog[]

  @@index([userId])
}

model RoutineLog {
  id          String   @id @default(cuid())
  routineId   String
  userId      String
  date        String
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())

  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@index([userId, date])
}

model Task {
  id                  String    @id @default(cuid())
  userId              String
  title               String
  description         String?
  type                String    @default("TASK")
  category            String    @default("General")
  priority            String    @default("MEDIUM")
  status              String    @default("PENDING")
  startDate           DateTime?
  dueDate             DateTime?
  remindBeforeMinutes Int       @default(15)
  reminderSent        Boolean   @default(false)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueDate])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String
  amount        Float
  category      String
  description   String?
  paymentMethod String   @default("Cash")
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type])
}

model CategoryOption {
  id        String   @id @default(cuid())
  userId    String
  name      String
  group     String   // "EXPENSE" | "INCOME" | "PAYMENT_METHOD" | "TASK_CATEGORY"
  color     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, group, name])
  @@index([userId, group])
}

