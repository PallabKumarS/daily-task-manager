{
	"name": "daily-task-tracker-workspace",
	"version": "2.0.0",
	"author": "Pallab Kumar Sarker",
	"private": true,
	"workspaces": [
		"server",
		"web-app",
		"desktop-app",
		"android-app"
	],
	"scripts": {
		"dev:server": "npm run dev --workspace=server",
		"dev:web": "npm run dev --workspace=web-app",
		"dev:desktop": "npm run dev --workspace=desktop-app",
		"build:server": "npm run build --workspace=server",
		"build:web": "npm run build --workspace=web-app",
		"build:desktop": "npm run build:desktop --workspace=desktop-app",
		"build:android": "npm run build --workspace=android-app",
		"build:apk": "npm run build:apk --workspace=android-app",
		"build": "npm run build:web",
		"build:all": "npm run build --workspaces",
		"db:push": "npm run db:push --workspace=server",
		"db:generate": "npm run db:generate --workspace=server"
	},
	"optionalDependencies": {
		"@tailwindcss/oxide-linux-arm64-gnu": "^4.3.3",
		"@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
		"@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
		"lightningcss-linux-arm64-gnu": "^1.32.0",
		"lightningcss-linux-x64-gnu": "^1.32.0",
		"lightningcss-linux-x64-musl": "^1.32.0"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
