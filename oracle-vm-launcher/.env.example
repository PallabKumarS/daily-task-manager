# ==============================================================================
# Oracle Cloud Infrastructure (OCI) Always Free VM Auto-Launcher Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OCI API Authentication Credentials
# In Oracle Console: Profile (top right) -> My Profile / User Settings -> API Keys -> "Add API Key"
# Download Private Key and copy the Configuration File preview values below.
# ------------------------------------------------------------------------------
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=ap-singapore-1
OCI_PRIVATE_KEY_PATH=./oci_private_key.pem

# Compartment OCID (For root compartment, this is identical to OCI_TENANCY_OCID)
OCI_COMPARTMENT_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 2. SSH Public Key
# Paste your public key string (e.g. from id_rsa.pub or id_ed25519.pub) or file path
# ------------------------------------------------------------------------------
OCI_SSH_PUBLIC_KEY="ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC..."
# OR path to your .pub file:
# OCI_SSH_PUBLIC_KEY_PATH=C:/Users/N3th3rLord/.ssh/id_rsa.pub

# ------------------------------------------------------------------------------
# 3. Instance Configuration (Matches your Oracle Console settings in image_87)
# ------------------------------------------------------------------------------
OCI_INSTANCE_NAME=nodejs-servers
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=1
OCI_MEMORY_IN_GBS=6
OCI_BOOT_VOLUME_SIZE_IN_GBS=50
OCI_BOOT_VOLUME_VPU=10
OCI_FAULT_DOMAIN=FAULT-DOMAIN-1

# Operating System search query (Auto-resolves OCID if not specified)
# Canonical Ubuntu 24.04 Minimal aarch64
OCI_IMAGE_SEARCH="Canonical Ubuntu 24.04 Minimal aarch64"
# Or provide exact image OCID if you have it:
# OCI_IMAGE_OCID=

# ------------------------------------------------------------------------------
# 4. Networking
# If OCI_SUBNET_OCID is left empty, the script automatically searches for an existing
# subnet named 'subnet-nodejs' in 'vcn-nodejs', or creates one if it doesn't exist yet!
# ------------------------------------------------------------------------------
OCI_VCN_NAME=vcn-nodejs
OCI_SUBNET_NAME=subnet-nodejs
OCI_SUBNET_OCID=
OCI_ASSIGN_PUBLIC_IP=true

# ------------------------------------------------------------------------------
# 5. Loop & Retry Settings
# ------------------------------------------------------------------------------
OCI_RETRY_INTERVAL_SECONDS=45
